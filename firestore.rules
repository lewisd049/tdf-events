rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function eventRef(eventId) { return /databases/$(database)/documents/events/$(eventId); }
    function registrationRef(eventId) { return /databases/$(database)/documents/registrations/$(request.auth.uid + '_' + eventId); }

    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount', 'updatedAt'])
        && ((request.resource.data.registrationCount == resource.data.registrationCount + 1
          && existsAfter(registrationRef(eventId))
          && getAfter(registrationRef(eventId)).data.userId == request.auth.uid
          && getAfter(registrationRef(eventId)).data.eventId == eventId)
          || (request.resource.data.registrationCount == resource.data.registrationCount - 1
          && exists(registrationRef(eventId))
          && get(registrationRef(eventId)).data.userId == request.auth.uid
          && !existsAfter(registrationRef(eventId))));
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if signedIn()
        && registrationId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.userId == request.auth.uid
        && get(eventRef(request.resource.data.eventId)).data.published == true
        && (get(eventRef(request.resource.data.eventId)).data.capacity == 0
          || getAfter(eventRef(request.resource.data.eventId)).data.registrationCount <= get(eventRef(request.resource.data.eventId)).data.capacity)
        && (!('registrationDeadline' in get(eventRef(request.resource.data.eventId)).data)
          || get(eventRef(request.resource.data.eventId)).data.registrationDeadline == null
          || request.time < get(eventRef(request.resource.data.eventId)).data.registrationDeadline);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
        && getAfter(eventRef(resource.data.eventId)).data.registrationCount == get(eventRef(resource.data.eventId)).data.registrationCount - 1);
      allow update: if false;
    }
  }
}
